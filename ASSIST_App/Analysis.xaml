<Window x:Class="ASSIST_App.Analysis"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ASSIST_App"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="Analysis"
        Height="750"
        Width="1100"
        MinHeight="450"
        MinWidth="800"
        Background="#F5F1FA">

    <Grid>

        <!-- LEFT SIDEBAR -->
        <Border BorderBrush="Black"
                BorderThickness="0.3"
                Width="235"
                HorizontalAlignment="Left"
                Background="#F5F1FA">

            <StackPanel Margin="10,10,15,15">

                <TextBlock Text="ASIST"
                           Foreground="Black"
                           FontSize="25"
                           FontWeight="Normal"
                           Height="52"
                           Width="180"/>

                <StackPanel Height="428">

                    <!-- New Chat -->
                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="10"
                            Height="55"
                            Margin="0,5">
                        <TextBlock Text="New Chat"
                                   FontSize="16"
                                   Foreground="Black"
                                   VerticalAlignment="Center"
                                   Margin="15,0"/>
                    </Border>

                    <!-- Help -->
                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="10"
                            Height="55"
                            Margin="0,5">
                        <TextBlock Text="Help"
                                   FontSize="16"
                                   Foreground="Black"
                                   VerticalAlignment="Center"
                                   Margin="15,0"/>
                    </Border>

                    <!-- Research -->
                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="10"
                            Height="55"
                            Margin="0,5">
                        <TextBlock Text="Research"
                                   FontSize="16"
                                   Foreground="Black"
                                   VerticalAlignment="Center"
                                   Margin="15,0"/>
                    </Border>

                    <!-- Settings -->
                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="10"
                            Height="55"
                            Margin="0,5">
                        <TextBlock Text="Settings"
                                   FontSize="16"
                                   Foreground="Black"
                                   VerticalAlignment="Center"
                                   Margin="15,0"/>
                    </Border>

                </StackPanel>
            </StackPanel>
        </Border>

        <!-- RIGHT CHAT AREA -->
        <Border Margin="235,0,0,0"
                Background="#F5F1FA">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOP BAR -->
                <Border Grid.Row="0"
                        Background="#222731"
                        BorderBrush="#343B49"
                        BorderThickness="0,0,0,1">

                    <TextBlock Text="ASIST Analysis"
                               Foreground="White"
                               FontSize="18"
                               VerticalAlignment="Center"
                               Margin="25,0"/>
                </Border>

                <!-- CONVERSATION AREA -->
                <ScrollViewer Grid.Row="1"
                              x:Name="conversationScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="conversationPanel"
                                Margin="30,25"/>


                </ScrollViewer>

                <!-- LOADING DISPLAY -->
                <Border x:Name="loadingPanel"
        Grid.Row="1"
        Visibility="Collapsed"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Margin="30,0,0,20"
        Background="#343B49"
        CornerRadius="12"
        Padding="18,12"
        MaxWidth="300">

                    <StackPanel>
                        <TextBlock Text="ASIST is thinking..."
                   Foreground="White"
                   FontSize="14"
                   Margin="0,0,0,10"/>

                        <ProgressBar Width="180"
                     Height="5"
                     IsIndeterminate="True"/>
                    </StackPanel>
                </Border>

                <!-- CHAT INPUT AREA -->
                <Border Grid.Row="2"
                        Background="#F5F1FA"
                        Padding="20">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- MESSAGE INPUT -->
                        <Border Grid.Column="0"
                                Background="#DCCBFA"
                                CornerRadius="12"
                                Padding="10">

                            <TextBox x:Name="messageInput"
                                     MinHeight="40"
                                     MaxHeight="100"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     Foreground="White"
                                     BorderThickness="0"
                                     FontSize="15"
                                     Padding="8"
                                     VerticalContentAlignment="Center"/>

                        </Border>

                        <!-- SEND BUTTON -->
                        <Button x:Name="btnSend"
                                Grid.Column="1"
                                Content="Send"
                                Width="75"
                                Height="42"
                                Margin="10,0,0,0"
                                Background="#DCCBFA"
                                Foreground="Black"
                                Click="Send_Click"/>

                        <!-- ANALYZE ANOTHER BUTTON -->
                        <Button x:Name="btnBack"
                                Grid.Column="2"
                                Content="Analyze Another"
                                Height="42"
                                Margin="10,0,0,0"
                                Padding="12,0"
                                Background="#DCCBFA"
                                Foreground="Black"
                                Click="btnBack_Click"/>

                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
