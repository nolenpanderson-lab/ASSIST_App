<Window x:Class="ASSIST_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow"
        WindowState="Maximized"
        Height="450"
        Width="800"
        Background="#F5F1FA">

    <Grid>
        <Viewbox Stretch="Uniform">
            <Grid Width="827" Height="450">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52*"/>
                    <RowDefinition Height="157*"/>
                    <RowDefinition Height="241*"/>
                </Grid.RowDefinitions>

                <!-- Top Navigation Bar -->
                <Border BorderBrush="Black"
                        BorderThickness="0,0,0,1"
                        Height="52"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Width="827">

                    <Grid Margin="0,0,-13,0">
                        <!-- Logo -->
                        <Label Content="ASIST"
                               FontSize="18"
                               Foreground="Black"
                               FontFamily="Rockwell"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>

                        <!-- Navigation Items -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0">

                            <Border BorderBrush="#7545B5"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,5"
                                    Margin="4">

                                <TextBlock Text="History"
                                           FontSize="14"
                                           Foreground="Black"/>
                            </Border>

                            <Border BorderBrush="#7545B5"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,5"
                                    Margin="4">

                                <TextBlock Text="Statistics"
                                           FontSize="14"
                                           Foreground="Black"/>
                            </Border>

                            <Border BorderBrush="#7545B5"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,5"
                                    Margin="4">

                                <TextBlock Text="Settings"
                                           FontSize="14"
                                           Foreground="Black"/>
                            </Border>

                            <Border BorderBrush="#7545B5"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,5"
                                    Margin="4">

                                <TextBlock Text="About"
                                           FontSize="14"
                                           Foreground="Black"/>
                            </Border>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Title -->
                <Label Content="ASIST Scam Detection"
                       Foreground="#7545B5"
                       FontSize="25"
                       FontFamily="Rockwell"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"
                       VerticalAlignment="Top" Grid.Row="1"/>

                <!-- Subtitle -->
                <Label Content="Assisting, Securing, Informing, Safeguarding you from Threats"
                       Foreground="#7545B5"
                       FontSize="12"
                       FontFamily="Rockwell"
                       HorizontalAlignment="Center"
                       Margin="0,49,0,0"
                       VerticalAlignment="Top" Grid.Row="1"/>

                <!-- Main Input Background -->
                <Border BorderBrush="Black"
                        BorderThickness="2"
                        CornerRadius="12"
                        Padding="20"
                        Background="#DCCBFA"
                        Margin="148,80,160,73" Grid.Row="1" Grid.RowSpan="2">

                    <Label Content="Enter Content*"
                           Foreground="Black"
                           FontFamily="Segoe UI Black"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Height="23"
                           Width="124"
                           Margin="10,-12,0,0"/>
                </Border>

                <!-- Message Input -->
                <Border BorderBrush="Lavender"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="5"
                        Margin="191,116,215,155" Grid.Row="1" RenderTransformOrigin="0.51,0.51" Grid.RowSpan="2">

                    <TextBox x:Name="contentTextBox"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Background="Transparent"
                             Foreground="Black"
                             BorderThickness="0"
                             FontSize="13"
                             Padding="3.5"
                             VerticalScrollBarVisibility="Auto"
                             AllowDrop="True"
                             TextChanged="contentTextBox_TextChanged"/>
                </Border>

                <!-- Analyze Button -->
                <Button x:Name="btnAnalyze"
                        Content="Analyze"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Width="88"
                        Height="40"
                        FontSize="14"
                        Background="#DCCBFA"
                        FontFamily="Segoe UI Black"
                        Margin="0,0,52,28"
                        Click="Button_Click1"
                        IsEnabled="True"
                        Panel.ZIndex="10" Grid.Row="2"/>
                <Button x:Name="btnAnalyze_Copy"
                    Content="Import from Device"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="140"
                    Height="40"
                    FontSize="14"
                    Background="#DCCBFA"
                    Foreground="Black"
                    Margin="0,0,450,14"
                    Click="Button_Click1"
                    IsEnabled="True"
                    Panel.ZIndex="10" Grid.Row="2"/>
                <Button x:Name="btnAnalyze_Copy1"
                    Content="Import URl"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="138"
                    Height="40"
                    FontSize="14"
                    Background="#DCCBFA"
                    Foreground="Black"
                    Margin="0,0,259,14"
                    Click="Button_Click1"
                    IsEnabled="True"
                    Panel.ZIndex="10" Grid.Row="2"/>
                <Border BorderBrush="Lavender"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,5"
                                    Margin="191,121,450,90" Grid.Row="2">

                    <TextBlock Text="Sender Email"
                        FontSize="14"
                        Foreground="Black" Margin="-11,-30,11,30"/>
                </Border>
                <Border BorderBrush="Lavender"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,5"
                                    Margin="446,120,191,90" Grid.Row="2">

                    <TextBlock Text="Email Subject"
                        FontSize="14"
                        Foreground="Black" Margin="-9,-30,9,30"/>
                </Border>

            </Grid>
        </Viewbox>
    </Grid>
</Window>
